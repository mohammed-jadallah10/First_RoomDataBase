<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    tools:ignore="HardcodedText,Autofill">

    <EditText
        android:id="@+id/first_ed"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="15dp"
        android:hint="Username"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:padding="15dp"

        />
    <EditText
        android:id="@+id/soc_ed"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Password"
        app:layout_constraintStart_toStartOf="@id/first_ed"
        app:layout_constraintEnd_toEndOf="@id/first_ed"
        app:layout_constraintTop_toBottomOf="@id/first_ed"
        android:padding="15dp"

        />
    <Button
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/soc_ed"
        app:layout_constraintStart_toStartOf="@id/soc_ed"
        app:layout_constraintEnd_toEndOf="@id/soc_ed"
        android:text="Login"
        android:layout_marginTop="20dp"/>



</androidx.constraintlayout.widget.ConstraintLayout>