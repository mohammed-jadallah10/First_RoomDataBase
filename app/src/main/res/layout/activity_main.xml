<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    tools:ignore="HardcodedText,Autofill">

    <EditText
        android:id="@+id/first_ed"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/edit_selector"
        android:fontFamily="monospace"
        android:hint="Name"
        android:inputType="text"
        android:padding="15dp"


        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintTop_toTopOf="parent" />
    <EditText
        android:id="@+id/soc_ed"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@id/first_ed"
        app:layout_constraintEnd_toEndOf="@id/first_ed"
        app:layout_constraintTop_toBottomOf="@id/first_ed"
        android:background="@drawable/edit_selector"
        android:padding="15dp"
        android:fontFamily="monospace"
        android:layout_marginTop="10dp"
        android:inputType="textEmailAddress"
        android:hint="Email"
        android:layout_marginBottom="20dp"

        />
    <EditText
        android:id="@+id/thr_ed"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@id/soc_ed"
        app:layout_constraintEnd_toEndOf="@id/soc_ed"
        app:layout_constraintTop_toBottomOf="@id/soc_ed"
        android:background="@drawable/edit_selector"
        android:fontFamily="monospace"

        android:padding="15dp"
        android:layout_marginTop="10dp"
        android:inputType="textPassword"
        android:hint="Password"


        />

    <Button
        android:id="@+id/button"
        android:layout_width="110dp"
        app:layout_constraintStart_toStartOf="@id/thr_ed"
        app:layout_constraintTop_toBottomOf="@id/thr_ed"

        app:layout_constraintEnd_toEndOf="@id/thr_ed"
        android:layout_marginTop="30dp"
        android:backgroundTint="#A64B4B"
        android:textColor="@color/white"
        android:background="@drawable/floating_shape"

        android:layout_height="wrap_content"
        android:text="Add"
      />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/Rv"
        android:layout_width="0dp"
        android:layout_height="450dp"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp"
        android:layout_marginTop="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/button" />


</androidx.constraintlayout.widget.ConstraintLayout>